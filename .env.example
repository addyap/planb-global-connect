# Copy to .env for local development. In production these are set in the Vercel project's
# Environment Variables settings (Vite inlines VITE_* vars at build time).

# Server-only (used by api/submit.ts; never prefix with VITE_)
RESEND_API_KEY=
# RESEND_FROM=Plan B Concept <noreply@planb-concept.com>
# Optional: secret for signing the forms' proof-of-work challenges (api/_lib/challenge.ts).
# If unset, one is derived from RESEND_API_KEY, so nothing needs configuring.
# FORM_SECRET=
